# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# n8n
N8N_BASE_URL=https://your-n8n.example.com/webhook
N8N_BEARER=
N8N_MODE=scripted
N8N_AGENT_NAME=n8n-reference-worker
N8N_REPORT_END=true
N8N_END_CALL=worker
# N8N_PATH_HANDOFF=/ar/lk/v1/handoff

# Tools (realtime and scripted mode)
N8N_MCP_URL=https://your-n8n.example.com/mcp/your-tools
N8N_MCP_TOKEN=

# Models (OpenAI-compatible; each stage can point at its own gateway)
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime
TTS_VOICE=marin
TTS_CACHE_DIR=.cache/tts

# Scripted mode
N8N_SCRIPT_FILE=examples/script.en.json
